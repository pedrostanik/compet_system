# Local development settings. Copy to .env (git-ignored) and fill in:  cp .env.example .env
# The API reads this file on startup (spring.config.import in application.yaml), and
# docker-compose.dev.yml reads it for the database password. Real environment variables win over it.
# Production does NOT use this file: its values come from AWS Secrets Manager (see OPERATIONS.md).

# Database — matches docker-compose.dev.yml
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/petshop
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Any string of 32+ characters (signs login tokens)
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters

# First OWNER account, created on the first start with an empty users table.
# Log in with this e-mail and APP_ADMIN_PASSWORD; create the other accounts in the app ("Usuários").
APP_OWNER_EMAIL=dono@exemplo.com
APP_OWNER_NAME=Dono
APP_ADMIN_PASSWORD=change-me

# Anthropic key for the AI features; any non-empty value works if you don't use them
ANTHROPIC_API_KEY=change-me
