#!/usr/bin/env sh
# Blocks commits that stage secrets. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it (winget install Gitleaks.Gitleaks) and reopen the terminal." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -v
